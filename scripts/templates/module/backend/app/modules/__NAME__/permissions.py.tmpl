"""Roles and permissions of the __NAME__ module, checked by the portal."""

from app.core.users.permissions import ADMIN
from app.shared.permissions import Permission, Role

# Role names come from the users core, and startup refuses any other name.
# Grant the module's permissions to more roles here as the module needs them.
ROLES: tuple[Role, ...] = (Role(ADMIN, frozenset({"__NAME__.view", "__NAME__.admin"})),)

# Every permission a role names must be declared here, or the app refuses to start.
# agent_allowed=False marks an act only a person may do, which an agent login never holds.
PERMISSIONS: tuple[Permission, ...] = (
    Permission("__NAME__.view", agent_allowed=True),
    Permission("__NAME__.admin", agent_allowed=True),
)
