import uuid

import pytest
from httpx import ASGITransport, AsyncClient

from app.core.users import CurrentPerson, current_person
from app.core.users.scope import DataScope
from app.main import app

pytestmark = pytest.mark.asyncio(loop_scope="session")


def _person(permissions: frozenset[str]) -> CurrentPerson:
    department = uuid.uuid4()
    return CurrentPerson(
        id=uuid.uuid4(),
        name="No Roles",
        email="no.roles@example.test",
        department_id=department,
        department_code="test",
        department_name="Test",
        roles=frozenset(),
        permissions=permissions,
        scope=DataScope(all_departments=False, department_ids=frozenset({department})),
    )


async def test_status_without_sign_in_is_unauthorized() -> None:
    async with AsyncClient(transport=ASGITransport(app=app), base_url="http://test") as client:
        response = await client.get("/api/__NAME__/status")
    assert response.status_code == 401
    assert response.headers["content-type"] == "application/problem+json"


async def test_status_without_permission_is_forbidden() -> None:
    app.dependency_overrides[current_person] = lambda: _person(frozenset())
    try:
        async with AsyncClient(transport=ASGITransport(app=app), base_url="http://test") as client:
            response = await client.get("/api/__NAME__/status")
    finally:
        _ = app.dependency_overrides.pop(current_person)
    assert response.status_code == 403
