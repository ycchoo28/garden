"""Create the __NAME__ schema."""

from collections.abc import Sequence

from alembic import op

revision: str = "__REVISION__"
down_revision: str | None = None
branch_labels: str | Sequence[str] | None = ("__NAME__",)
depends_on: str | Sequence[str] | None = None


def upgrade() -> None:
    op.execute("CREATE SCHEMA IF NOT EXISTS __NAME__")


def downgrade() -> None:
    op.execute("DROP SCHEMA __NAME__")
