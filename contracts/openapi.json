              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "An error, as a problem document"
          }
        },
        "summary": "Read Confirmation",
        "x-agent": {
          "confirm": false,
          "save": true,
          "tool": true
        }
      }
    },
    "/api/confirmations/{confirmation_id}/decision": {
      "post": {
        "description": "Approve or reject a pending confirmation. Only a browser sign-in may do this.",
        "operationId": "confirmations.request.decide",
        "parameters": [
          {
            "in": "path",
            "name": "confirmation_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Confirmation Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DecisionIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfirmationOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
