          }
        },
        "summary": "List Cli Logins",
        "x-agent": {
          "confirm": false,
          "save": true,
          "tool": true
        }
      },
      "post": {
        "description": "Finish a CLI login with the code the browser returned. The token is shown once.",
        "operationId": "users.cli_login.create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CliLoginIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CliLoginCreated"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Validation failed"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "An error, as a problem document"
          }
        },
        "summary": "Create Cli Login",
        "x-agent": {
          "confirm": false,
          "save": true,
          "tool": false
        }
      }
    },
    "/api/cli-logins/authorize": {
      "get": {
        "description": "Start a CLI login. Redirects the browser to the identity provider, which returns the code to a listener on this machine.",
        "operationId": "users.cli_login.start",
        "parameters": [
          {
            "in": "query",
            "name": "redirect_uri",
            "required": true,
            "schema": {
              "maxLength": 300,
              "title": "Redirect Uri",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "state",
            "required": true,
            "schema": {
              "maxLength": 128,
              "minLength": 16,
              "title": "State",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "nonce",
            "required": true,
            "schema": {
              "maxLength": 128,
              "minLength": 16,
              "title": "Nonce",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "code_challenge",
            "required": true,
            "schema": {
              "maxLength": 128,
              "minLength": 43,
              "title": "Code Challenge",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Validation failed"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "An error, as a problem document"
          }
        },
        "summary": "Start Cli Login",
        "x-agent": {
          "confirm": false,
          "save": true,
          "tool": false
        }
      }
    },
