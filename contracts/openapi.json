          "tool": true
        }
      }
    },
    "/api/claims/{claim_id}/decision": {
      "post": {
        "description": "Approve or reject the claim's current step. A rejection needs a reason. Person-only: an agent cannot approve or reject a claim.",
        "operationId": "claims.claim.decide",
        "parameters": [
          {
            "in": "path",
            "name": "claim_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Claim Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
