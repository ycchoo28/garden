                }
              }
            },
            "description": "Validation failed"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "An error, as a problem document"
          }
        },
        "summary": "Decide Claim",
        "tags": [
          "claims"
        ],
        "x-agent": {
          "confirm": false,
          "save": true,
          "tool": false
        }
      }
    },
