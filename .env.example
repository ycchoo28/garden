# Dev-only values. `just setup` copies this to .env (ignored by git).
GARDEN_ENVIRONMENT=dev
GARDEN_DATABASE_URL=postgresql+psycopg://garden:garden-dev@127.0.0.1:55432/garden
# The mock OIDC server in dev/compose.yaml. Refused outside dev (GARDEN_FAKE_OIDC).
GARDEN_OIDC_ISSUER=http://127.0.0.1:55081/default
GARDEN_OIDC_CLIENT_ID=garden-dev
GARDEN_OIDC_CLIENT_SECRET=garden-dev-secret
GARDEN_FAKE_OIDC=true
GARDEN_FILES_ROOT=var/files
GARDEN_PUBLIC_URL=http://localhost:55173
